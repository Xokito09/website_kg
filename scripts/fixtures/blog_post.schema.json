{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaptasglobal.io/schemas/blog_post.schema.json",
  "title": "Kaptas Global blog post",
  "contract_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "meta_title",
    "meta_description",
    "excerpt",
    "categories",
    "author",
    "date",
    "reading_time_min",
    "key_takeaways",
    "body_md",
    "faq",
    "related",
    "cover",
    "sources"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 60
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "meta_title": {
      "type": "string",
      "maxLength": 60
    },
    "meta_description": {
      "type": "string",
      "maxLength": 155
    },
    "excerpt": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "bio"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reading_time_min": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "key_takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "body_md": {
      "type": "string"
    },
    "faq": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "q",
          "a"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        }
      }
    },
    "related": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title_short",
        "motif"
      ],
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title_short": {
          "type": "string"
        },
        "motif": {
          "type": "string",
          "enum": [
            "comparison",
            "list",
            "cost",
            "guide",
            "map",
            "news"
          ]
        }
      }
    },
    "list_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "url",
          "quote"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "notes_for_rodolfo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
